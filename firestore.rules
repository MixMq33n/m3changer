rules_version = '2';
// Paste into Firebase console → Firestore → Rules → Publish.
// One profile per account at users/{uid}. Only the owner can read it; it is created once on first sign-in
// and afterwards only the name can change. Everything else in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 60;
    }
    function validPromo(promo) {
      return promo == null || (promo is string && promo.matches('^[A-Za-zА-Яа-яЁё0-9_-]{2,40}$'));
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'promo_code', 'created_at'])
        && validName(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && validPromo(request.resource.data.promo_code)
        && request.resource.data.created_at == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
